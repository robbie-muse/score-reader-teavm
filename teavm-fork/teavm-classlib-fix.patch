@@ -15,13 +15,102 @@
  */
 package org.teavm.classlib.java.awt;
 
-public class TPoint {
+import java.awt.Point;
+import java.awt.geom.Point2D;
+
+/**
+ * TeaVM's emulation of {@code java.awt.Point}.
+ *
+ * FORK FIX (2026-11-08, score-reader TeaVM investigation, function #272):
+ * this class used to extend {@code java.lang.Object} directly, although in
+ * real Java {@code Point extends Point2D}. TeaVM therefore emitted
+ * {@code Point} and {@code Point2D} as sibling WasmGC struct types, and any
+ * {@code Point} passed where a {@code Point2D} is expected produced an
+ * invalid module that Node rejects at load time
+ * ({@code call_ref[1] expected type (ref null 48), found block of type
+ * (ref null 467)}). Making {@code TPoint} extend {@code Point2D} restores
+ * the real hierarchy. The {@code Point2D} superclass is resolved through
+ * TeaVM's class substitution: there is no {@code TPoint2D} in the
+ * classlib, so the program's own {@code java.awt.geom.Point2D} (if any)
+ * is used; in a vanilla TeaVM program that class is absent, so the
+ * upstream fix should also add a classlib {@code TPoint2D}.
+ *
+ * The API surface below mirrors {@code java.awt.Point} (JDK 25):
+ * constructors, {@code getX}/{@code getY}/{@code setLocation} (the three
+ * abstract methods of {@code Point2D}), {@code getLocation},
+ * {@code move}, {@code translate}, {@code equals} and {@code toString}.
+ * {@code hashCode} is inherited from {@code Point2D}. Rounding follows
+ * the JDK: {@code setLocation(double, double)} rounds half-up via
+ * {@code (int) Math.floor(x + 0.5)}.
+ */
+public class TPoint extends Point2D {
 
     public int x;
     public int y;
 
+    public TPoint() {
+        this(0, 0);
+    }
+
     public TPoint(int x, int y) {
         this.x = x;
         this.y = y;
     }
+
+    public TPoint(Point p) {
+        this(p.x, p.y);
+    }
+
+    @Override
+    public double getX() {
+        return x;
+    }
+
+    @Override
+    public double getY() {
+        return y;
+    }
+
+    public Point getLocation() {
+        return new Point(x, y);
+    }
+
+    public void setLocation(int x, int y) {
+        this.x = x;
+        this.y = y;
+    }
+
+    public void setLocation(Point p) {
+        setLocation(p.x, p.y);
+    }
+
+    @Override
+    public void setLocation(double x, double y) {
+        this.x = (int) Math.floor(x + 0.5);
+        this.y = (int) Math.floor(y + 0.5);
+    }
+
+    public void move(int x, int y) {
+        this.x = x;
+        this.y = y;
+    }
+
+    public void translate(int dx, int dy) {
+        x += dx;
+        y += dy;
+    }
+
+    @Override
+    public boolean equals(Object obj) {
+        if (obj instanceof Point) {
+            Point pt = (Point) obj;
+            return (x == pt.x) && (y == pt.y);
+        }
+        return super.equals(obj);
+    }
+
+    @Override
+    public String toString() {
+        return getClass().getName() + "[x=" + x + ",y=" + y + "]";
+    }
 }

 package org.teavm.classlib.java.awt;
 
-public class TDimension {
+import java.awt.Dimension;
+import java.awt.geom.Dimension2D;
+
+/**
+ * TeaVM's emulation of {@code java.awt.Dimension}.
+ *
+ * FORK FIX (2026-11-08, score-reader TeaVM investigation, function #272):
+ * this class used to extend {@code java.lang.Object} directly, although in
+ * real Java {@code Dimension extends Dimension2D} — the same defect as
+ * {@code TPoint} vs {@code Point2D}, which made any {@code Dimension}
+ * passed where a {@code Dimension2D} is expected emit an invalid WasmGC
+ * module. Making {@code TDimension} extend {@code Dimension2D} restores
+ * the real hierarchy. The {@code Dimension2D} superclass is resolved
+ * through TeaVM's class substitution: there is no {@code TDimension2D}
+ * in the classlib, so the program's own {@code java.awt.geom.Dimension2D}
+ * (if any) is used; the upstream fix should also add a classlib
+ * {@code TDimension2D}.
+ *
+ * The API surface below mirrors {@code java.awt.Dimension} (JDK 25):
+ * constructors (including the copy constructor, which was missing),
+ * {@code getWidth}/{@code getHeight}/{@code setSize(double, double)}
+ * (the three abstract methods of {@code Dimension2D}), {@code getSize},
+ * {@code setSize} overloads, {@code equals}, {@code hashCode} and
+ * {@code toString}. Rounding follows the JDK: {@code setSize(double,
+ * double)} rounds up via {@code (int) Math.ceil(...)}.
+ */
+public class TDimension extends Dimension2D {
 
     public int width;
     public int height;
 
+    public TDimension() {
+        this(0, 0);
+    }
+
     public TDimension(int width, int height) {
         this.width = width;
         this.height = height;
     }
+
+    public TDimension(Dimension d) {
+        this(d.width, d.height);
+    }
+
+    @Override
+    public double getWidth() {
+        return width;
+    }
+
+    @Override
+    public double getHeight() {
+        return height;
+    }
+
+    public Dimension getSize() {
+        return new Dimension(width, height);
+    }
+
+    public void setSize(Dimension d) {
+        setSize(d.width, d.height);
+    }
+
+    public void setSize(int width, int height) {
+        this.width = width;
+        this.height = height;
+    }
+
+    @Override
+    public void setSize(double width, double height) {
+        this.width = (int) Math.ceil(width);
+        this.height = (int) Math.ceil(height);
+    }
+
+    @Override
+    public boolean equals(Object obj) {
+        if (obj instanceof Dimension) {
+            Dimension d = (Dimension) obj;
+            return (width == d.width) && (height == d.height);
+        }
+        return false;
+    }
+
+    @Override
+    public int hashCode() {
+        int sum = width + height;
+        return sum * (sum + 1) / 2 + width;
+    }
+
+    @Override
+    public String toString() {
+        return getClass().getName() + "[width=" + width + ",height=" + height + "]";
+    }
 }
diff --git a/classlib/src/main/java/org/teavm/classlib/java/awt/TPoint.java b/classlib/src/main/java/org/teavm/classlib/java/awt/TPoint.java
